{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animation project v1",
  "type": "object",
  "required": [
    "version",
    "id",
    "duration",
    "actors"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string"
    },
    "script": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "width": {
      "type": "integer",
      "minimum": 160,
      "maximum": 3840,
      "multipleOf": 2,
      "default": 1080
    },
    "height": {
      "type": "integer",
      "minimum": 160,
      "maximum": 3840,
      "multipleOf": 2,
      "default": 1920
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 30
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audio": {
          "type": "string",
          "minLength": 1,
          "description": "Local path relative to this project.json"
        },
        "renderAudio": {
          "type": "string",
          "minLength": 1,
          "description": "Local path relative to this project.json"
        },
        "envelope": {
          "type": "string",
          "minLength": 1,
          "description": "Local path relative to this project.json"
        }
      }
    },
    "board": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "subtitle": {
          "type": "string",
          "maxLength": 160
        },
        "detail": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "props": {
      "type": "object",
      "properties": {
        "phone": {
          "type": "boolean"
        },
        "cookieJars": {
          "type": "boolean"
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          }
        }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "style",
          "path"
        ],
        "properties": {
          "id": {
            "enum": [
              "primary",
              "secondary"
            ]
          },
          "style": {
            "enum": [
              "hoodie",
              "waistcoat"
            ]
          },
          "path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "t",
                "x",
                "z"
              ],
              "properties": {
                "t": {
                  "type": "number",
                  "minimum": 0
                },
                "x": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              }
            }
          },
          "cues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                },
                "emotion": {
                  "enum": [
                    "neutral",
                    "worried",
                    "curious",
                    "happy"
                  ]
                },
                "action": {
                  "enum": [
                    "idle",
                    "gesture",
                    "phone",
                    "book",
                    "nod"
                  ]
                },
                "look": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              }
            }
          },
          "speech": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "camera": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t",
          "position",
          "target"
        ],
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "target": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "foley": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "kind"
        ],
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "step",
              "wood",
              "paper",
              "buzz"
            ]
          },
          "gain": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.15
          }
        }
      }
    }
  },
  "description": "Runtime validation also checks ordering, intervals against duration, actor identity and shared prop conflicts."
}
